local function createHealthGui(character, targetPlayer)
	if targetPlayer == player or not healthBarOn then return end

	local head = character:FindFirstChild("Head")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not head or not humanoid then return end

	local old = head:FindFirstChild("HealthBillboard")
	if old then old:Destroy() end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "HealthBillboard"
	billboard.Adornee = head
	billboard.AlwaysOnTop = true
	billboard.Size = UDim2.fromOffset(120, 42)
	billboard.StudsOffset = Vector3.new(0, 2.8, 0)
	billboard.Parent = head

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1,0,0,18)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.Code
	nameLabel.TextScaled = true
	nameLabel.TextStrokeTransparency = 0
	nameLabel.TextColor3 = Color3.new(1,1,1)
	nameLabel.Text = targetPlayer.Name
	nameLabel.Parent = billboard

	local back = Instance.new("Frame")
	back.Size = UDim2.new(1,-10,0,10)
	back.Position = UDim2.new(0,5,0,24)
	back.BackgroundColor3 = Color3.fromRGB(40,40,40)
	back.BorderSizePixel = 0
	back.Parent = billboard

	local corner = Instance.new("UICorner")
	corner.Parent = back

	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.Size = UDim2.fromScale(1,1)
	bar.BackgroundColor3 = Color3.fromRGB(0,255,0)
	bar.BorderSizePixel = 0
	bar.Parent = back

	local barCorner = Instance.new("UICorner")
	barCorner.Parent = bar

	local hp = Instance.new("TextLabel")
	hp.Size = UDim2.new(1,0,0,14)
	hp.Position = UDim2.new(0,0,1,2)
	hp.BackgroundTransparency = 1
	hp.Font = Enum.Font.Code
	hp.TextScaled = true
	hp.TextStrokeTransparency = 0
	hp.TextColor3 = Color3.new(1,1,1)
	hp.Parent = billboard

	local function update()
		if not humanoid or not humanoid.Parent then return end
		local percent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
		bar.Size = UDim2.new(percent, 0, 1, 0)

		if percent > 0.6 then
			bar.BackgroundColor3 = Color3.fromRGB(0,255,0)
		elseif percent > 0.3 then
			bar.BackgroundColor3 = Color3.fromRGB(255,200,0)
		else
			bar.BackgroundColor3 = Color3.fromRGB(255,0,0)
		end

		hp.Text = string.format("%d / %d", humanoid.Health, humanoid.MaxHealth)
	end

	update()
	humanoid.HealthChanged:Connect(update)
	humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(update)
end

