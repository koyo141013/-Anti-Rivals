local function updateMouseState(isVisible)
	if mouseLoopConnection then
		mouseLoopConnection:Disconnect()
		mouseLoopConnection = nil
	end

	if isVisible then
		if not modalButton then
			modalButton = Instance.new("TextButton")
			modalButton.Size = UDim2.fromScale(1, 1)
			modalButton.BackgroundTransparency = 1
			modalButton.Text = ""
			modalButton.Modal = true
			modalButton.Active = false
			modalButton.ZIndex = 1
			modalButton.Parent = gui
		end

		mouseLoopConnection = trackConn(RunService.RenderStepped:Connect(function()
			if window.Visible then
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
				UserInputService.MouseIconEnabled = true
			end
		end))
	else
		if modalButton then
			modalButton:Destroy()
			modalButton = nil
		end
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		UserInputService.MouseIconEnabled = false
	end
end

