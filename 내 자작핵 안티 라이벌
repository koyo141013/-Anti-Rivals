-- Noclip
local function applyNoclip()
	local character = player.Character
	if not character then return end

	for _, object in character:GetDescendants() do
		if object:IsA("BasePart") then
			if collisionValues[object] == nil then
				collisionValues[object] = object.CanCollide
			end
			object.CanCollide = false
		end
	end
end

local function stopNoclip()
	noclipOn = false
	if noclipConnection then noclipConnection:Disconnect() end
	noclipConnection = nil

	for part, previous in pairs(collisionValues) do
		if part and part.Parent then part.CanCollide = previous end
	end

	collisionValues = {}
	setToggle(noclipButton, false, "noclip")
end

local function startNoclip()
	noclipOn = true
	applyNoclip()
	noclipConnection = RunService.Stepped:Connect(function()
		if noclipOn then applyNoclip() end
	end)
	setToggle(noclipButton, true, "noclip")
end

