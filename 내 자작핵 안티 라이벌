local function stopFly()
	flying = false
	if flyConnection then flyConnection:Disconnect() end
	if velocity then velocity:Destroy() end
	if orientation then orientation:Destroy() end
	if attachment then attachment:Destroy() end

	flyConnection, velocity, orientation, attachment = nil, nil, nil, nil

	local humanoid, root = getSafeParts()
	if humanoid then
		humanoid.PlatformStand = false
		humanoid.AutoRotate = true
	end
	setToggle(flyButton, false, "fly")
end

local function startFly()
	local humanoid, root = getSafeParts()
	if not humanoid or not root then return end
	
	flying = true
	humanoid.PlatformStand = true
	humanoid.AutoRotate = false

	attachment = Instance.new("Attachment")
	attachment.Parent = root

	velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	velocity.ForceLimitsEnabled = true
	velocity.MaxForce = 100000
	velocity.Parent = root

	orientation = Instance.new("AlignOrientation")
	orientation.Attachment0 = attachment
	orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	orientation.RigidityEnabled = true
	orientation.Parent = root

	flyConnection = RunService.RenderStepped:Connect(function()
		if not flying or not root or not root.Parent then return end

		local camera = workspace.CurrentCamera
		if not camera then return end

		local look = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
		local right = Vector3.new(camera.CFrame.RightVector.X, 0, camera.CFrame.RightVector.Z)
		if look.Magnitude > 0 then look = look.Unit end
		if right.Magnitude > 0 then right = right.Unit end

		local direction = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction += look end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction -= look end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction -= right end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction += right end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then direction += Vector3.yAxis end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then direction -= Vector3.yAxis end
		
		if velocity and velocity.Parent then
			velocity.VectorVelocity = direction.Magnitude > 0
				and direction.Unit * flySpeed
				or Vector3.zero
		end
		if look.Magnitude > 0 and orientation and orientation.Parent then
			orientation.CFrame = CFrame.lookAt(Vector3.zero, look)
		end
	end)
	setToggle(flyButton, true, "fly")
end

local function toggleFly(forceState)
	local targetState = forceState ~= nil and forceState or not flying
	if targetState then startFly() else stopFly() end
end

local function applyWalk()
	local humanoid, _ = getSafeParts()
	if humanoid then
		humanoid.WalkSpeed = walkOn and walkSpeed or 16
	end
end

local function applyJump()
	local humanoid, _ = getSafeParts()
	if humanoid then
		humanoid.UseJumpPower = true
		humanoid.JumpPower = jumpOn and jumpPower or 50
	end
end

-- ESP System
local function removeESP(character)
	if not character then return end
	local highlight = character:FindFirstChild("AntiRivalESP")
	local nameTag = character:FindFirstChild("AntiRivalName")
	if highlight then highlight:Destroy() end
	if nameTag then nameTag:Destroy() end
end

local function createESP(character, targetPlayer)
