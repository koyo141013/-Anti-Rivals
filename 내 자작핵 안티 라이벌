	button.BackgroundColor3 = enabled
		and Color3.fromRGB(35, 75, 50)
		or Color3.fromRGB(70, 30, 30)
	button.BorderColor3 = enabled
		and Color3.fromRGB(50, 110, 70)
		or Color3.fromRGB(100, 45, 45)
end

