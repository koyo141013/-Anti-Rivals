if makefolder and not isfolder(folderName) then
	pcall(function() makefolder(folderName) end)
end

local function refreshConfigList()
	for _, child in ipairs(configListFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local files = {}
	if listfiles then
		pcall(function()
			files = listfiles(folderName)
		end)
	end

	local count = 0
	for _, file in ipairs(files) do
		local fileName = file:gsub(folderName .. "/", ""):gsub(folderName .. "\\", "")
		if fileName:sub(-5) == ".json" then
			local cfgName = fileName:sub(1, -6)
			count = count + 1

			local itemBtn = Instance.new("TextButton")
			itemBtn.Size = UDim2.new(1, -6, 0, 28)
			itemBtn.BackgroundTransparency = 1
			itemBtn.TextXAlignment = Enum.TextXAlignment.Left
			itemBtn.TextSize = 13
			itemBtn.Font = Enum.Font.Code

			if cfgName == selectedConfig then
				itemBtn.Text = "  ✓  " .. cfgName
				itemBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			else
				itemBtn.Text = "     " .. cfgName
				itemBtn.TextColor3 = Color3.fromRGB(140, 145, 155)
			end

			itemBtn.Parent = configListFrame

			itemBtn.MouseButton1Click:Connect(function()
				selectedConfig = cfgName
				configNameBox.Text = cfgName
				refreshConfigList()
			end)
		end
	end

	configListFrame.CanvasSize = UDim2.new(0, 0, 0, count * 30)
end

local function getSavedData()
	return {
		flySpeed = flySpeed,
		walkSpeed = walkSpeed,
		jumpPower = jumpPower,
		gammaValue = gammaValue,
		fastShotRate = fastShotRate,
		rageStuds = rageStuds,
