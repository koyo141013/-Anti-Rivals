-- [ESP 및 플레이어 네임 독립 구동형 완벽 수정 시스템]
----------------------------------------------------
local espCache = {}

local function removeEsp(p)
	if espCache[p] then
		if espCache[p].Highlight then
			espCache[p].Highlight:Destroy()
		end
		if espCache[p].Billboard then
			espCache[p].Billboard:Destroy()
		end
		espCache[p] = nil
	end
end

local function updateEspForPlayer(p)
	if p == player then return end
	local char = p.Character
	-- ESP 또는 네임 중 하나라도 켜져 있어야 작동하도록 조건 수정
	if (not espOn and not namesOn) or not char or not char:FindFirstChild("HumanoidRootPart") then
		removeEsp(p)
		return
	end

	local highlight = espCache[p] and espCache[p].Highlight
	if espOn then
		if not highlight or not highlight.Parent then
			highlight = Instance.new("Highlight")
			highlight.Name = "AntiRivalESP"
			highlight.Adornee = char
			highlight.FillColor = Color3.fromRGB(255, 50, 50)
			highlight.FillTransparency = 0.5
			highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
			highlight.OutlineTransparency = 0
			highlight.Parent = char
		else
			highlight.Adornee = char
		end
	else
		if highlight then
			highlight:Destroy()
			highlight = nil
		end
	end

	local head = char:FindFirstChild("Head")
	local billboard = espCache[p] and espCache[p].Billboard
	
	if namesOn and head then
		if not billboard or not billboard.Parent then
			billboard = Instance.new("BillboardGui")
			billboard.Name = "AntiRivalName"
			billboard.Size = UDim2.new(0, 120, 0, 50)
			billboard.StudsOffset = Vector3.new(0, 2.8, 0)
			billboard.AlwaysOnTop = true
			billboard.Adornee = head

			local textLabel = Instance.new("TextLabel")
			textLabel.Name = "NameText"
			textLabel.Size = UDim2.fromScale(1, 1)
			textLabel.BackgroundTransparency = 1
			textLabel.Text = p.Name
			textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			textLabel.TextSize = 13
			textLabel.Font = Enum.Font.Code
			textLabel.TextStrokeTransparency = 0
			textLabel.Parent = billboard

			billboard.Parent = head
		else
			billboard.Adornee = head
			local textLabel = billboard:FindFirstChild("NameText")
			if textLabel then
				textLabel.Text = p.Name
			end
		end
	else
		if billboard then
			billboard:Destroy()
			billboard = nil
		end
	end

	espCache[p] = { Highlight = highlight, Billboard = billboard }
end

trackConn(RunService.RenderStepped:Connect(function()
	if not espOn and not namesOn then
		for p, _ in pairs(espCache) do
			removeEsp(p)
		end
		return
	end

	for _, p in ipairs(Players:GetPlayers()) do
		updateEspForPlayer(p)
	end
end))

trackConn(Players.PlayerRemoving:Connect(function(p)
	removeEsp(p)
end))

