local function getTargetPart(character, targetPartType)
	if not character then return nil end
	if targetPartType:lower() == "head" then
		return character:FindFirstChild("Head")
	else
		return character:FindFirstChild("HumanoidRootPart")
			or character:FindFirstChild("UpperTorso")
			or character:FindFirstChild("Torso")
	end
end

local cachedTarget = nil
local lastTargetCheck = 0

local function getClosestTarget(maxFOV, targetPartType)
	local now = os.clock()
	if now - lastTargetCheck < 0.03 and cachedTarget and cachedTarget.Parent then
		return cachedTarget
	end
	lastTargetCheck = now

	local camera = workspace.CurrentCamera
	if not camera then return nil end

	local closestPart = nil
	local shortestDistance = maxFOV or math.huge
	local viewportCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= player and target.Character then
			local part = getTargetPart(target.Character, targetPartType)
			local humanoid = target.Character:FindFirstChildOfClass("Humanoid")

			if part and humanoid and humanoid.Health > 0 then
				local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
				if onScreen and screenPos.Z > 0 then
					local mouseDist = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
					if mouseDist < shortestDistance then
						shortestDistance = mouseDist
						closestPart = part
					end
				end
			end
		end
	end

	cachedTarget = closestPart
	return closestPart
end

-- 사일런트 에임 후킹
pcall(function()
	if typeof(hookmetamethod) == "function" then
		local oldNamecall
		local oldIndex

		oldNamecall = hookmetamethod(game, "__namecall", newcclosure_fn(function(self, ...)
			local method = typeof(getnamecallmethod) == "function" and getnamecallmethod() or ""
			local args = {...}

			if silentAimOn and not checkcaller_fn() then
				if (method == "Raycast" or method == "raycast") and (self == workspace or self == game.Workspace) then
					local targetPart = getClosestTarget(silentAimFOV, silentAimTargetPart)
					if targetPart then
						local origin = args[1]
						if typeof(origin) == "Vector3" and oldNamecall then
							args[2] = (targetPart.Position - origin).Unit * (args[2].Magnitude > 0 and args[2].Magnitude or 10000)
							return oldNamecall(self, unpack_fn(args))
						end
					end
				end
			end

			if oldNamecall then
				return oldNamecall(self, ...)
			end
		end))

		oldIndex = hookmetamethod(game, "__index", newcclosure_fn(function(self, index)
			if silentAimOn and not checkcaller_fn() then
				if typeof(self) == "Instance" and self:IsA("Mouse") then
					if index == "Hit" then
						local targetPart = getClosestTarget(silentAimFOV, silentAimTargetPart)
						if targetPart then return targetPart.CFrame end
					elseif index == "Target" then
						local targetPart = getClosestTarget(silentAimFOV, silentAimTargetPart)
						if targetPart then return targetPart end
					end
				end
			end

			if oldIndex then
				return oldIndex(self, index)
			end
		end))
	end
end)

-- Rage Bot
local function getRageTargetHead()
	local _, myRoot = getSafeParts()
	if not myRoot then return nil end

	local closestHead = nil
	local shortestDistance = rageStuds

	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= player and target.Character then
			local head = target.Character:FindFirstChild("Head")
			local humanoid = target.Character:FindFirstChildOfClass("Humanoid")

			if head and humanoid and humanoid.Health > 0 then
				local dist = (myRoot.Position - head.Position).Magnitude
				if dist <= shortestDistance then
					shortestDistance = dist
					closestHead = head
				end
			end
		end
	end
	return closestHead
end

