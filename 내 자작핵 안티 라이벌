local function getTargetPart(character, targetPartType)
	if not character then return nil end
	if targetPartType == "head" then
		return character:FindFirstChild("Head")
	else
		return character:FindFirstChild("HumanoidRootPart")
			or character:FindFirstChild("UpperTorso")
			or character:FindFirstChild("Torso")
	end
end

local function getClosestTarget(maxDistance, targetPartType)
	local camera = workspace.CurrentCamera
	if not camera then return nil end

	local closestPart = nil
	local shortestDistance = maxDistance or math.huge
	local viewportCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

	for _, target in Players:GetPlayers() do
		if target ~= player and target.Character then
			local part = getTargetPart(target.Character, targetPartType)
			local humanoid = target.Character:FindFirstChild("Humanoid")

			if part and humanoid and humanoid.Health > 0 then
				local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
				if onScreen then
					local mouseDist = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
					if mouseDist < shortestDistance then
						shortestDistance = mouseDist
						closestPart = part
					end
				end
			end
		end
	end
	return closestPart
end

