trackConn(RunService.RenderStepped:Connect(function()
	if not ragebotOn then return end
	pcall(function()
		local currentCam = getActiveCamera()
		local bestTarget = nil
		local shortestDist = math.huge

		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				local char = p.Character
				if char then
					local hum = char:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health > 0 then
						local targetPart = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
						if targetPart then
							local _, onScreen = currentCam:WorldToViewportPoint(targetPart.Position)
							if onScreen then
								local dist = (targetPart.Position - currentCam.CFrame.Position).Magnitude
								if dist < shortestDist then
									shortestDist = dist
									bestTarget = targetPart
								end
							end
						end
					end
				end
			end
		end

		if bestTarget then
			currentCam.CFrame = CFrame.new(currentCam.CFrame.Position, bestTarget.Position)
		end
	end)
end))

trackConn(RunService.RenderStepped:Connect(function()
	if not auraOn then return end
	pcall(function()
		local _, root = getSafeParts()
		if not root then return end

		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				local char = p.Character
				if char then
					local hum = char:FindFirstChildOfClass("Humanoid")
					local targetRoot = char:FindFirstChild("HumanoidRootPart")
					if hum and hum.Health > 0 and targetRoot then
						local dist = (targetRoot.Position - root.Position).Magnitude
						if dist <= 45 then
							pcall(function()
								for _, tool in ipairs(player.Character:GetChildren()) do
									if tool:IsA("Tool") then tool:Activate() end
								end
							end)
						end
					end
				end
			end
		end
	end)
end))

trackConn(RunService.RenderStepped:Connect(function()
	if orbitOn then
		pcall(function()
			local _, root = getSafeParts()
			if root then
				local t = os.clock() * 5
				local radius = 25
				local offset = Vector3.new(math.cos(t) * radius, 10, math.sin(t) * radius)
				root.CFrame = CFrame.new(root.Position + offset)
			end
		end)
	elseif voidSpanOn then
		pcall(function()
			local _, root = getSafeParts()
			if root then
				root.CFrame = CFrame.new(root.Position + Vector3.new(0, 500, 0))
			end
		end)
	end
end))

trackConn(RunService.RenderStepped:Connect(function()
	if not teleporterOn then return end
	local now = os.clock()
	if now - lastTeleportTick >= 0.1 then
		lastTeleportTick = now
		pcall(function()
			local _, root = getSafeParts()
			if root then
				local randomAngle = math.random() * math.pi * 2
				local offsetX = math.cos(randomAngle) * teleportDistance
				local offsetZ = math.sin(randomAngle) * teleportDistance
				local currentPos = root.Position
				root.CFrame = CFrame.new(currentPos.X + offsetX, currentPos.Y + 50, currentPos.Z + offsetZ)
			end
		end)
	end
end))

