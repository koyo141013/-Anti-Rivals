end

-- Save
saveBtn.MouseButton1Click:Connect(function()
	local name = configNameBox.Text
	if name == "" then
		configStatus.Text = "Status: Enter a valid config name!"
		configStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
		return
	end

	local filePath = folderName .. "/" .. name .. ".json"
	local jsonStr = HttpService:JSONEncode(getSavedData())

	local success = pcall(function()
		if writefile then writefile(filePath, jsonStr) end
	end)

	if success then
		selectedConfig = name
		configStatus.Text = "Status: Saved '" .. name .. "'"
		configStatus.TextColor3 = Color3.fromRGB(100, 255, 100)
		refreshConfigList()
	else
		configStatus.Text = "Status: Save failed!"
		configStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
	end
end)

-- Load
loadBtn.MouseButton1Click:Connect(function()
	if selectedConfig == "" then
		configStatus.Text = "Status: Select a config to load!"
		configStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
		return
	end

	local filePath = folderName .. "/" .. selectedConfig .. ".json"
	local success = pcall(function()
		if readfile and isfile and isfile(filePath) then
			local data = HttpService:JSONDecode(readfile(filePath))

			if data.flySpeed then flySpeed = data.flySpeed; flyBox.Text = tostring(flySpeed) end
			if data.walkSpeed then walkSpeed = data.walkSpeed; walkBox.Text = tostring(walkSpeed) end
			if data.jumpPower then jumpPower = data.jumpPower; jumpBox.Text = tostring(jumpPower) end
			if data.gammaValue then 
				gammaValue = data.gammaValue
				gammaBox.Text = tostring(gammaValue)
				gamma.Brightness = (gammaValue - 1) / 99
			end
			if data.fastShotRate then fastShotRate = data.fastShotRate; fastShotBox.Text = tostring(fastShotRate) end
			if data.rageStuds then rageStuds = data.rageStuds; rageStudsBox.Text = tostring(rageStuds) end
			if data.silentAimFOV then silentAimFOV = data.silentAimFOV; silentAimBox.Text = tostring(silentAimFOV) end
			if data.aimbotSmoothness then aimbotSmoothness = data.aimbotSmoothness; aimbotBox.Text = tostring(aimbotSmoothness) end
			if data.aimbotTargetPart then 
				aimbotTargetPart = data.aimbotTargetPart
				aimbotPartButton.Text = "aimbot target: " .. aimbotTargetPart:upper()
			end
			if data.silentAimTargetPart then 
				silentAimTargetPart = data.silentAimTargetPart
				silentAimPartButton.Text = "silent target: " .. silentAimTargetPart:upper()
			end
			if data.espColor then
				espColor = Color3.fromRGB(data.espColor.r, data.espColor.g, data.espColor.b)
				redBox.Text = tostring(data.espColor.r)
				greenBox.Text = tostring(data.espColor.g)
				blueBox.Text = tostring(data.espColor.b)
			end
		else
			error("File missing")
		end
	end)

	if success then
		configStatus.Text = "Status: Loaded '" .. selectedConfig .. "'"
		configStatus.TextColor3 = Color3.fromRGB(100, 255, 100)
	else
		configStatus.Text = "Status: Load failed!"
		configStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
	end
end)

