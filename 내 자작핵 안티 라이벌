toggleFly = function(state)
	flyOn = state
	setToggle(flyButton, flyOn, "fly")
	local hum, root = getSafeParts()

	if flyOn then
		if not root or not hum then 
			flyOn = false
			setToggle(flyButton, false, "fly")
			return 
		end

		bodyGyro = Instance.new("BodyGyro")
		bodyGyro.P = 9e4
		bodyGyro.MaxTorque = Vector3.new(9e4, 9e4, 9e4)
		bodyGyro.CFrame = root.CFrame
		bodyGyro.Parent = root

		bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.Velocity = Vector3.zero
		bodyVelocity.MaxForce = Vector3.new(9e4, 9e4, 9e4)
		bodyVelocity.Parent = root

		hum.PlatformStand = true

		flyConnection = RunService.RenderStepped:Connect(function()
			local currentCam = getActiveCamera()
			local currentHum, currentRoot = getSafeParts()
			if not flyOn or not currentRoot or not currentHum or currentHum.Health <= 0 then
				if toggleFly then toggleFly(false) end
				return
			end

			if bodyGyro then bodyGyro.CFrame = currentCam.CFrame end
			local moveDir = Vector3.zero
			
			-- PC 키보드 입력 감지
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + currentCam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - currentCam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - currentCam.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + currentCam.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
				moveDir = moveDir - Vector3.new(0, 1, 0)
			end

			-- 모바일 이동 조이스틱(MoveDirection) 완벽 연동 지원
			if currentHum.MoveDirection.Magnitude > 0 then
				moveDir = moveDir + (currentCam.CFrame:VectorToWorldSpace(Vector3.new(currentHum.MoveDirection.X, 0, currentHum.MoveDirection.Z)).Unit)
			end

			if bodyVelocity then 
				if moveDir.Magnitude > 0 then
					bodyVelocity.Velocity = moveDir.Unit * flySpeed
				else
					bodyVelocity.Velocity = Vector3.zero
				end
			end
		end)
		trackConn(flyConnection)
	else
		if flyConnection then
			flyConnection:Disconnect()
			flyConnection = nil
		end
		if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
		if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end

		if hum then
			hum.PlatformStand = false
		end
	end
end

trackConn(UserInputService.InputBegan:Connect(function(input, gp)
	if bindingTarget and bindingButton then
		if input.KeyCode ~= Enum.KeyCode.Unknown then
			keybinds[bindingTarget] = input.KeyCode
			bindingButton.Text = input.KeyCode.Name
			bindingButton.TextColor3 = Color3.fromRGB(200, 200, 205)
			bindingTarget, bindingButton = nil, nil
			return
		end
	end

	if not gp then
		if keybinds.Speed and input.KeyCode == keybinds.Speed then
			walkOn = not walkOn
			setToggle(walkButton, walkOn, "walk speed")
			local h, _ = getSafeParts()
			if h then h.WalkSpeed = walkOn and walkSpeed or 16 end
		end
		if keybinds.Fly and input.KeyCode == keybinds.Fly then
			if toggleFly then toggleFly(not flyOn) end
		end
		if keybinds.ESP and input.KeyCode == keybinds.ESP then
			espOn = not espOn
			setToggle(espButton, espOn, "player esp")
		end
		if keybinds.Noclip and input.KeyCode == keybinds.Noclip then
			noclipOn = not noclipOn
			setToggle(noclipButton, noclipOn, "noclip")
		end
		if keybinds.Teleport and input.KeyCode == keybinds.Teleport then
			teleporterOn = not teleporterOn
			setToggle(teleporterButton, teleporterOn, "auto 50k tp (every 0.1s)")
		end
		if keybinds.VoidSpan and input.KeyCode == keybinds.VoidSpan then
			voidSpanOn = not voidSpanOn
			if voidSpanOn then orbitOn = false setToggle(orbitButton, false, "orbit position mode") end
			setToggle(voidSpanButton, voidSpanOn, "void span mode")
		end
	end

	if input.KeyCode == Enum.KeyCode.RightShift then
		window.Visible = not window.Visible
		updateMouseState(window.Visible)
	end
end))

