local function stopFly()
	flying = false
	if velocity then velocity:Destroy() end
	if orientation then orientation:Destroy() end
	if attachment then attachment:Destroy() end
	velocity, orientation, attachment = nil, nil, nil

	local humanoid, _ = getSafeParts()
	if humanoid then
		humanoid.PlatformStand = false
		humanoid.AutoRotate = true
	end
	setToggle(flyButton, false, "fly")
end

local function startFly()
	local humanoid, root = getSafeParts()
	if not humanoid or not root then return end
	
	flying = true
	humanoid.PlatformStand = true
	humanoid.AutoRotate = false

	attachment = Instance.new("Attachment", root)
	velocity = Instance.new("LinearVelocity", root)
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	velocity.ForceLimitsEnabled = true
	velocity.MaxForce = 100000

	orientation = Instance.new("AlignOrientation", root)
	orientation.Attachment0 = attachment
	orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	orientation.RigidityEnabled = true

	trackConn(RunService.RenderStepped:Connect(function()
		if not flying or not root or not root.Parent then return end
		local camera = workspace.CurrentCamera
		if not camera then return end

		local look = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z).Unit
		local right = Vector3.new(camera.CFrame.RightVector.X, 0, camera.CFrame.RightVector.Z).Unit
		local direction = Vector3.zero

		if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction += look end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction -= look end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction -= right end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction += right end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then direction += Vector3.yAxis end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then direction -= Vector3.yAxis end
		
		if velocity then
			velocity.VectorVelocity = direction.Magnitude > 0 and direction.Unit * flySpeed or Vector3.zero
		end
		if orientation and look.Magnitude > 0 then
			orientation.CFrame = CFrame.lookAt(Vector3.zero, look)
		end
	end))
	setToggle(flyButton, true, "fly")
end

-- Fast Shot 엔진 루프[cite: 1]
trackConn(RunService.RenderStepped:Connect(function()
	if not fastShotOn then return end

	if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
		local now = os.clock()
		local interval = 1 / math.clamp(fastShotRate, 1, 1000)

		if now - lastShotTick >= interval then
			lastShotTick = now
			pcall(function()
				local char = player.Character
				if not char then return end

				for _, tool in ipairs(char:GetChildren()) do
					if tool:IsA("Tool") then
						pcall(function() tool:Activate() end)
						for _, desc in ipairs(tool:GetDescendants()) do
							if desc:IsA("RemoteEvent") then
								pcall(function()
									local name = desc.Name:lower()
									if name:find("fire") or name:find("shoot") or name:find("gun") or name:find("attack") then
										desc:FireServer()
									end
								end)
							end
						end
					end
				end
			end)
		end
	end
end))

-- Noclip 루프[cite: 1]
trackConn(RunService.Stepped:Connect(function()
	if noclipOn then
		pcall(function()
			local char = player.Character
			if char then
				for _, part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") and part.CanCollide then
						part.CanCollide = false
					end
				end
			end
		end)
	end
end))

