trackConn(UserInputService.InputBegan:Connect(function(input, gp)
	if bindingTarget and bindingButton then
		if input.KeyCode ~= Enum.KeyCode.Unknown then
			keybinds[bindingTarget] = input.KeyCode
			bindingButton.Text = input.KeyCode.Name
			bindingButton.TextColor3 = Color3.fromRGB(200, 200, 205)
			bindingTarget, bindingButton = nil, nil
			return
		end
	end

	if not gp then
		if keybinds.Speed and input.KeyCode == keybinds.Speed then
			walkOn = not walkOn
			setToggle(walkButton, walkOn, "walk speed")
			local h, _ = getSafeParts()
			if h then h.WalkSpeed = walkOn and walkSpeed or 16 end
		end
		if keybinds.Fly and input.KeyCode == keybinds.Fly then
			if toggleFly then toggleFly(not flyOn) end
		end
		if keybinds.ESP and input.KeyCode == keybinds.ESP then
			espOn = not espOn
			setToggle(espButton, espOn, "player esp")
		end
		if keybinds.Noclip and input.KeyCode == keybinds.Noclip then
			noclipOn = not noclipOn
			setToggle(noclipButton, noclipOn, "noclip")
		end
		if keybinds.Teleport and input.KeyCode == keybinds.Teleport then
			teleporterOn = not teleporterOn
			setToggle(teleporterButton, teleporterOn, "auto 50k tp (every 0.1s)")
		end
	end

	if input.KeyCode == Enum.KeyCode.RightShift then
		window.Visible = not window.Visible
		updateMouseState(window.Visible)
	end
end))

-- 레이지봇 루프
trackConn(RunService.RenderStepped:Connect(function()
	if not ragebotOn then return end
	pcall(function()
		local currentCam = getActiveCamera()
		local bestTarget = nil
		local shortestDist = math.huge

		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				local char = p.Character
				if char then
					local hum = char:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health > 0 then
						local targetPart = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
						if targetPart then
							local _, onScreen = currentCam:WorldToViewportPoint(targetPart.Position)
							if onScreen then
								local dist = (targetPart.Position - currentCam.CFrame.Position).Magnitude
								if dist < shortestDist then
									shortestDist = dist
									bestTarget = targetPart
								end
							end
						end
					end
				end
			end
		end

		if bestTarget then
			currentCam.CFrame = CFrame.new(currentCam.CFrame.Position, bestTarget.Position)
		end
	end)
end))

-- 오라 루프
trackConn(RunService.RenderStepped:Connect(function()
	if not auraOn then return end
	pcall(function()
		local _, root = getSafeParts()
		if not root then return end

		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				local char = p.Character
				if char then
					local hum = char:FindFirstChildOfClass("Humanoid")
					local targetRoot = char:FindFirstChild("HumanoidRootPart")
					if hum and hum.Health > 0 and targetRoot then
						local dist = (targetRoot.Position - root.Position).Magnitude
						if dist <= 45 then
							pcall(function()
								for _, tool in ipairs(player.Character:GetChildren()) do
									if tool:IsA("Tool") then
										tool:Activate()
									end
								end
							end)
						end
					end
				end
			end
		end
	end)
end))

